# Copy to .env for local development.
FLASK_ENV=development
DATABASE_URL=postgresql://kingmoverskenya:kingmoverskenya@localhost:5432/kingmoverskenya
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRES_HOURS=12
CORS_ORIGINS=http://localhost:5173
# Optional: real driving distances via Google Distance Matrix API
GOOGLE_MAPS_API_KEY=
# Use redis://... in production when running more than one instance
RATELIMIT_STORAGE_URI=memory://
